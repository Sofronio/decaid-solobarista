{
  "id": "solobarista.reaplugin",
  "name": "Solobarista Scale",
  "author": "Sofronio",
  "description": "SOLO Barista LSJ-001 scale with weight and timer telemetry.",
  "version": "0.1.0",
  "apiVersion": 1,
  "permissions": ["transport.ble"],
  "drivers": [{
    "id": "solobarista",
    "type": "scale",
    "capabilities": [
      "tare",
      "timerControl",
      "timerTelemetry",
      "disconnectToSleep"
    ],
    "ble": {"match": {"name": {"contains": "lsj-001"}}}
  }],
  "settings": {},
  "api": []
}
